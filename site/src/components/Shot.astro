---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Loads at once, for the picture at the top of the page. */
  eager?: boolean;
}
const { src, alt, eager = false } = Astro.props;
---
<figure>
<div class="shot">
  <Image src={src} alt={alt} widths={[640, 1000, 1400, 1800]} sizes="(min-width: 1100px) 1100px, 94vw" format="webp" quality={82}
    loading={eager ? 'eager' : 'lazy'} />
</div>
{!eager && <figcaption class="caption">{alt}</figcaption>}
</figure>
