---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
}
const { id, eyebrow, title } = Astro.props;
---
<section class="feature" id={id}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <div class="lead"><slot name="text" /></div>
  <div class="visuals"><slot /></div>
</section>
