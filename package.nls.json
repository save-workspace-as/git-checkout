  "configuration.title": "Git Checkout",
  "config.gitCheckout.branch.nameSeparator.description": "Separator used when a new branch name is prefilled from the current branch. With /, user/feat/foo starts as user/feat/ and the cursor is placed after the slash. The same separator is used for other new-branch prompts.",
  "config.gitCheckout.branch.nameSeparator.enum.slash": "Slash-separated names, such as user/feat/topic.",
  "config.gitCheckout.branch.nameSeparator.enum.hyphen": "Hyphen-separated names, such as user-feat-topic.",
  "config.gitCheckout.branch.nameSeparator.enum.underscore": "Underscore-separated names, such as user_feat_topic.",
  "config.gitCheckout.customCommands.description": "Commands shown in Quick Launch. context is branch, file, submodule, or url. command may include ${branch}, ${file}, ${submodule}, ${url}, ${repo}, and ${sha}. A url command that expands to http or https opens in the browser. Other commands run in the integrated terminal on the workspace host.",
  "config.gitCheckout.customCommands.items.command.description": "Shell command or http(s) URL template.",
  "config.gitCheckout.customCommands.items.context.description": "Which placeholder the command is built around.",
  "config.gitCheckout.customCommands.items.name.description": "Label in Quick Launch.",
  "config.gitCheckout.externalDiff.enabled.description": "Run git difftool on the workspace host. In-app diffs stay the default while this is off. On SSH, WSL, or Dev Containers the GUI diff tool must be installed on that host. Configure diff.tool or diff.guitool first.",
  "config.gitCheckout.externalMerge.enabled.description": "Run git mergetool on the workspace host. In-app conflict resolution stays the default while this is off. On SSH, WSL, or Dev Containers the GUI merge tool must be installed on that host. Configure merge.tool or merge.guitool first.",
  "config.gitCheckout.git.skipHooks.description": "Pass --no-verify to push and commit.",
  "config.gitCheckout.graph.showReflog.description": "Show commits that only the reflog reaches, such as dropped commits and old stash states, in the all-commits graph. Repository settings can override this per repository.",
  "config.gitCheckout.graph.showRemoteBranches.description": "Show remote-tracking branches, such as origin/main, in the graph. A repository can override this with the Git setting gitcheckout.graph.showRemoteBranches.",
  "config.gitCheckout.graph.showStashes.description": "Show stash entries in the graph. A repository can override this with the Git setting gitcheckout.graph.showStashes.",
  "config.gitCheckout.graph.showTags.description": "Show tags in the graph. A repository can override this with the Git setting gitcheckout.graph.showTags.",
  "config.gitCheckout.branch.rememberCheckout.description": "Remember whether Create Branch last checked out the new branch, and start with that choice next time.",
  "config.gitCheckout.checkout.updateSubmodules.description": "After a checkout, update submodules to the commits the checked-out commit records.",
  "config.gitCheckout.clone.defaultFolder.description": "Folder that Clone Repository starts in when asking where to clone. When empty, it starts in the parent folder of the open repository.",
  "config.gitCheckout.commit.pushAfterCommit.description": "Push the current branch after every commit from the Changes view. Amending a commit does not push.",
  "config.gitCheckout.commit.subjectLengthLimit.description": "Mark the commit subject as too long when it has more characters than this. Set to 0 to turn it off.",
  "config.gitCheckout.commit.subjectWarningLength.description": "Suggest a shorter commit subject when it has more characters than this. Set to 0 to turn it off.",
  "config.gitCheckout.diff.changeMarks.description": "Show + and − beside added and removed lines in diffs.",
  "config.gitCheckout.diff.syntaxHighlighting.description": "Color code in diffs and file previews by language.",
  "config.gitCheckout.fetch.includeTags.description": "Fetch all tags from remotes, including tags that do not point into fetched branches, on every fetch and auto-fetch.",
  "config.gitCheckout.graph.compactBranchLabels.description": "Show a local branch and its remote-tracking branches at the same commit as one label in the commit graph.",
  "config.gitCheckout.graph.githubAvatars.description": "Show the GitHub profile picture of each commit author, for repositories on GitHub. Asks github.com which account made a commit, once per author, using your GitHub sign-in in VS Code when there is one.",
  "config.gitCheckout.graph.gravatar.description": "Show Gravatar images for commit authors. Sends a SHA-256 hash of each author's email to gravatar.com.",
  "config.gitCheckout.graph.order.description": "Commit order in the graph.",
  "config.gitCheckout.graph.order.enum.date": "Interleave branches by commit date.",
  "config.gitCheckout.graph.order.enum.topo": "Keep each branch's commits together.",
  "config.gitCheckout.leanBranching.stashOnSwitch.description": "When the working tree is dirty, stash before checkout or pull and pop afterward.",
  "config.gitCheckout.network.timeoutMs.description": "Timeout (ms) for fetch, pull, and push operations.",
  "config.gitCheckout.autoFetch.enabled.description": "Fetch from the remotes of every open repository in the background, so the graph shows what others pushed. It never asks for a password, and it waits while the window is in the background or a merge or rebase is in progress.",
  "config.gitCheckout.autoFetch.intervalSeconds.description": "Seconds between background fetches.",
  "config.gitCheckout.watch.debounceMs.description": "Debounce window (ms) for coalescing Git watch events.",
